<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Sterling Studios</title>
  <link rel="stylesheet" href="style.css">
</head>

<body>

  <header>
    <nav>
      <div class="logo">STERLING<span>STUDIOS</span></div>

      <div class="nav-links">
        <a href="#services">Services</a>
        <a href="#portfolio">Portfolio</a>
        <a href="#pricing">Pricing</a>
        <a href="#contact">Contact</a>
      </div>
    </nav>

    <div class="hero">
      <p class="eyebrow">STERLING STUDIOS</p>

<a href="#contact" class="hero-button">Start Your Project</a>

      <h1>We Build Your <span>Vision.</span></h1>

      <p class="description">
        Premium video editing, graphic design, and digital creativity
        for creators and businesses.
      </p>

      <a class="button" href="#contact">Start a Project</a>
    </div>
  </header>

  <section id="services">
    <p class="section-label">WHAT WE DO</p>
    <h2>Our Services</h2>

    <div class="cards">
      <div class="card">
        <h3>Video Editing</h3>
        <p>Professional short-form edits for creators and brands.</p>
      </div>

      <div class="card">
        <h3>Thumbnails</h3>
        <p>Eye-catching thumbnails designed to grab attention.</p>
      </div>

      <div class="card">
        <h3>Graphic Design</h3>
        <p>Clean logos, profile graphics, and promotional designs.</p>
      </div>
    </div>
  </section>

  <section id="portfolio">
    <p class="section-label">OUR WORK</p>
    <h2>Portfolio</h2>
<div>
  <img src="images/sterling-logo.png"
       alt="Sterling Studios logo"
       class="portfolio-image">
  <h3>Sterling Studios Logo Concept</h3>
  <p>A custom futuristic logo concept.</p>
</div>
<div class="portfolio-box">
  <div>
    <img src="images/minecraft-thumbnail.png"
         alt="Minecraft thumbnail"
         class="portfolio-image">
    <h3>Hardcore Minecraft Thumbnail</h3>
    <p>Designed by Sterling Studios.</p>
  </div>
</div>
  </section>
<div class="video-showcase">
  <h2>Our Studio in Action</h2>

  <video controls width="100%">
    <source src="videos/Sterling-Studios-Promo-16x9.mp4" type="video/mp4">
  </video>

  <video controls width="100%">
    <source src="videos/Sterling-Studios-Promo-9x16.mp4" type="video/mp4">
  </video>
</div>

<section id="pricing">
  <p class="section-label">INVEST IN YOUR BRAND</p>
  <h2>Our Services & Pricing</h2>

  <div class="pricing-container">

    <div class="pricing-card">
      <h3>YouTube Thumbnails</h3>
      <h2>$5</h2>
      <p>Eye-catching custom thumbnails.</p>
    </div>

    <div class="pricing-card">
      <h3>Custom Logos</h3>
      <h2>$10</h2>
      <p>Unique branding for your identity.</p>
    </div>

    <div class="pricing-card">
      <h3>Video Editing</h3>
      <h2>$15</h2>
      <p>Professional short-form video edits.</p>
    </div>

  </div>
</section>

  <section id="contact" class="contact">
    <p class="section-label">LET'S WORK TOGETHER</p>
    <h2>Start Your Project</h2>

    <p>
      Ready to create something great? Contact Sterling Studios
      to discuss your project.
    </p>

    <a class="button" href="mailto:sterlingstudiosoffical@gmail.com">Contact Sterling</a>
  </section>

  <footer>
    © 2026 Sterling Studios. All rights reserved.
  </footer>
<section id="contact">
  <p class="section-label">LET'S WORK TOGETHER</p>
  <h2>Start Your Project</h2>
  <p>Tell us what you need, and we'll help bring your idea to life.</p>

  <form action="mailto:YOUR" method="post" enctype="text/plain">
    <label>Your name</label>
    <input type="text" name="name" placeholder="Your name" required>

    <label>What service do you need?</label>
    <select name="service">
      <option>YouTube Thumbnail</option>
      <option>Custom Logo</option>
      <option>Short-Form Video Editing</option>
    </select>

    <label>Project details</label>
    <textarea name="details" placeholder="Describe your project..." required></textarea>

    <button type="submit">Send Project Request</button>
  </form>
</section>
</body>
</html>
